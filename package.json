{
  "name": "ruutin",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev --port 3100",
    "local:up": "docker compose up --detach --build",
    "local:down": "docker compose down",
    "local:logs": "docker compose logs --follow web",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "build:staging": "CLOUDFLARE_ENV=staging npm run build",
    "build:production": "CLOUDFLARE_ENV=production npm run build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "preview:cloudflare": "npm run build && wrangler dev --config dist/server/wrangler.json",
    "deploy:staging": "npm run build:staging && wrangler deploy --config dist/server/wrangler.json",
    "deploy:production": "npm run build:production && wrangler deploy --config dist/server/wrangler.json",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:staging": "wrangler d1 migrations apply DB --env staging --remote",
    "db:migrate:production": "wrangler d1 migrations apply DB --env production --remote",
    "types:cloudflare": "wrangler types worker-configuration.d.ts",
    "format:check": "node scripts/check-format.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:render",
    "test:unit": "tsx --test tests/*.test.ts",
    "test:render": "npm run build && node --test tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "quality": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run scan:secrets",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@fontsource/fraunces": "^5.3.0",
    "drizzle-orm": "0.45.2",
    "qrcode": "1.5.4",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/qrcode": "1.5.5",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
