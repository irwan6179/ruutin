# Server-only Sites runtime variables. Never prefix these with NEXT_PUBLIC_.
EMAIL_API_URL=https://api.resend.com/emails
EMAIL_API_KEY=replace_with_sites_secret
EMAIL_FROM=noreply@your-verified-domain.example
AUTH_HMAC_SECRET=replace_with_sites_secret
SESSION_SECRET=replace_with_sites_secret

# Optional local-only Vite settings. Put these in ignored `.env.local` when
# testing the one-click demo over a private Tailnet HTTPS hostname.
# RUUTIN_LOCAL_DEMO_LOGIN=enabled
# RUUTIN_LOCAL_DEMO_HOSTS=your-device.tailnet.ts.net
